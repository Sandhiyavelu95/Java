Question no : 01

public class hello{

    int marks;
    String name;

    // create constructor (class name and constructor name should be same)

    hello(){                      //can create multiple constructor with same name but with different paramater

        System.out.println("empty parameter");
    }

    hello(int a)
    {
        System.out.println(a);        //passing value using constructor
        System.out.println("hello world");
    }
    
    public static void main(String args[]){

        hello obj1 = new hello(10); 
        hello obj2 = new hello();       //if there is two obj defaultly two times the constructor will called
        

        System.out.println(obj1.marks);   //if we didn't declare value for variable automatically "0" will print
        System.out.println(obj1.name);    //for string "null"  will print
    }
}




