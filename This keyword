import java.util.Scanner;

class laptop{

    String name = "asus";    // can create a multiple class in single file
}

class bike{

    int price = 1000;
}

public class hello{

    public static void main(String args[]){

        laptop l1 = new laptop(); 
        System.out.println(l1.name);           //for laptop class we can use only a "laptop" obj name  to get or print a value

        bike b1 = new bike();
        System.out.println(b1.price);
    }

}

