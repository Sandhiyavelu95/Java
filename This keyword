public class hello{

    String myname = null;

    void setname(String myname){

        // System.out.println(myname);      //if you give like this "null" value will print
         
        this.myname = myname;            //here this is represented as obj1
    }

    public static void main(String args[]){

        hello obj1 = new hello();
        obj1.setname("ranjani");        // setting name
      System.out.println(obj1.myname);  //calling the name
