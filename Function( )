inside main func get integer i/p from user for total mark.
pass that i/p to the passorfail func and let the func decide whether std is passorfail


import java.util.Scanner;
public class hello{
    String passorfail (int tot_mark){
        if(tot_mark>35){
            return "pass";
        }
        else{
            return"fail";
        }

    }
