/* coding challenge : Animal Kingdom
challenge overview:

you will create classes represeenting animals in zoo. 
Start by creating a base class and then create subclasses
for specific animal with additional
properties and behaviors  

Step 1 :

create a class named Animal :

Add a field called name of type String .
Add a field called age of type int.
Add a method(func) called makeSound() that prints
"Animal makes a sound".


Step 2 :

Create a subclass named dog that inherits(extends) from 
Animal:

add a field called breed of type String.
override(use the func in chid calss that already in parent class ) the makeSound() method to print "Dog barks"
Add a method(function) called fetch() that prints "Dog is fetching"


Step 3:

Create a subclass nameed cat that inherits(extends) from Animal;
Add a field called color of type String.
override the makeSound() method to print "cat meows".
add a method(func) called climb() that prints "cat is climbing".
*/



import java.util.Scanner;
class Animal{             //patent class
    String name;
    int age;

    void makeSound(){
        System.out.println("Animal makes sound");
    }
}
class Dog extends Animal{
    String breed;

    //override
    void makeSound(){
        System.out.println("dog barks");
    }
    void fetch(){
        System.out.println("Dog is fetching");
    }
}
class Cat extends Animal{
    String color;

    //override
    void makeSound(){
        System.out.println("Cat meows");
    }
    void climb(){
        System.out.println("Cat is climbing");
    }
}
public class hello{
    public static void main(String args[]){
      Dog d1 = new Dog();
      d1.name = "rio"; //in parent class
      d1.age = 1; //in parent class
      d1.breed = "normal";
      d1.makeSound();
      d1.fetch();

      Cat c1 = new Cat();
      c1.name = "ruby";
      c1.age= 2;
      c1.color = "white";
      c1.makeSound();
      c1.climb();
    }
}

