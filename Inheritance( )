  //**********single inheritance**********/

//single child class inherits the properties and methods from only one parent class.

Question no : 02

import java.util.Scanner;

class Animal{      //super class or base class or parent class

    void eat(){

        System.out.println("this animal can eat");
    }
}
class Dog extends Animal{   //derived class

    void bark(){

        System.out.println("Barks");
    }
}
public class hello{
    public static void main(String args[]){

        Dog d1 = new Dog(); //creating obj for dog
        d1.bark();   //calling bark func in dog class
        d1.eat();    //can also access the eat func in animal class bcus using keyword "extends"
    }
}



